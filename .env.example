# Copy this file to `.env` (project root) and fill in real values.
# `.env` is git-ignored — never commit real API keys.
#
# Read by backend/llm/config.py, which loads this file automatically via
# python-dotenv before any LLM call. Used by backend/feedback/feedback_generator.py
# today, and by backend/llm/teacher_model.py / student_model.py in the later
# distillation phase.

# --- Required ---------------------------------------------------------------

# Your OpenCode Go API key. Get one at https://opencode.ai/zen — sign in,
# subscribe to Go, and copy the key it gives you. (Any OpenAI-compatible
# provider's key works here too, e.g. DeepSeek's own API or OpenRouter — this
# client isn't OpenCode-specific, just validated against it.)
ZIQRA_LLM_API_KEY=

# The OpenAI-compatible base URL for your provider.
#   OpenCode Go:  https://opencode.ai/zen/v1
#   DeepSeek:     https://api.deepseek.com
#   OpenRouter:   https://openrouter.ai/api/v1
ZIQRA_LLM_BASE_URL=https://opencode.ai/zen/v1

# The model ID to use, exactly as your provider lists it. For OpenCode Go,
# run `/models` in the OpenCode TUI (or GET {ZIQRA_LLM_BASE_URL}/models with
# your key) to see the exact slugs available on your account — they change
# over time and vary by subscription tier.
ZIQRA_LLM_MODEL=

# --- Optional (sensible defaults if unset) ----------------------------------

# Sampling temperature (0.0-2.0, provider-dependent range). Default: 0.3
ZIQRA_LLM_TEMPERATURE=0.3

# Max tokens in the model's response. Default: 1024
ZIQRA_LLM_MAX_TOKENS=1024

# Per-request timeout in seconds. Default: 60
ZIQRA_LLM_TIMEOUT_SECONDS=60

# Number of automatic retries the SDK performs on transient failures
# (network errors, 429/5xx) before giving up. Default: 2
ZIQRA_LLM_MAX_RETRIES=2

# --- Teacher model (backend/llm/anthropic_client.py) ------------------------
#
# Separate provider config for the distillation pipeline's teacher/parent
# model — independent from ZIQRA_LLM_* above (the live feedback path keeps
# using that one, unchanged). This one speaks the Anthropic Messages API
# protocol (POST /v1/messages), not the OpenAI-compatible chat.completions
# protocol, so it uses the official `anthropic` SDK via a different client
# class. Same var names, just prefixed ZIQRA_TEACHER_ instead of ZIQRA_LLM_.

# OpenCode Go's "Go" endpoint (Anthropic-Messages-compatible) — confirmed via
# a live test call to return HTTP 200 with model qwen3.7-plus.
#
# NOTE: no trailing /v1 here — the `anthropic` Python SDK appends /v1/messages
# to base_url itself (mirroring how it treats the real api.anthropic.com), so
# including /v1 in this value produces a doubled .../v1/v1/messages 404.
ZIQRA_TEACHER_API_KEY=
ZIQRA_TEACHER_BASE_URL=https://opencode.ai/zen/go
ZIQRA_TEACHER_MODEL=qwen3.7-plus

# Optional (sensible defaults if unset) — same meaning as the ZIQRA_LLM_ ones.
ZIQRA_TEACHER_TEMPERATURE=0.3
ZIQRA_TEACHER_MAX_TOKENS=1024
ZIQRA_TEACHER_TIMEOUT_SECONDS=60
ZIQRA_TEACHER_MAX_RETRIES=2
